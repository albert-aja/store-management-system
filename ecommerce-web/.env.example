# ==============================================================================
# STORE MANAGEMENT SYSTEM (SMS) — E-COMMERCE STOREFRONT ENVIRONMENT TEMPLATE
# Module: Infrastructure Setup (Backlog [A.5] & ADR-12 Next.js + API Gateway)
# ==============================================================================
# Copy this file to ecommerce-web/.env or ecommerce-web/.env.local:

# Authoritative Storefront API Gateway base endpoint (Next.js & Vite compatible)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1/storefront
BACKEND_INTERNAL_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api/v1/storefront

# Supabase Authentication (Customer OAuth2 & Session)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<anon-key>
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<anon-key>

# Storefront Branding & CDN
NEXT_PUBLIC_STOREFRONT_NAME=SMS Mart Online
NEXT_PUBLIC_IMAGE_CDN_URL=http://localhost:8080/api/v1/storefront/images
VITE_STOREFRONT_NAME=SMS Mart Online
VITE_IMAGE_CDN_URL=http://localhost:8080/api/v1/storefront/images
