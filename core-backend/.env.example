# ==============================================================================
# STORE MANAGEMENT SYSTEM (SMS) — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Module: Infrastructure Setup (Backlog [A.5])
# ==============================================================================
# Copy this file to core-backend/.env or export these in your host shell:

# --- Spring Boot Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL Connection (Local or Supabase) ---
# Local Docker:
# SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/sms
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=postgres
#
# Production Supabase Connection Pooler (Port 6543 / PgBouncer):
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<db-password>

# --- High-Concurrency Redis 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sms_redis_secret_password_2026

# --- Supabase Auth & JWT Resource Server ---
# Supabase Auth JWKS JSON endpoint for JWT validation (Spring Security OAuth2 Resource Server)
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=sms-documents

# --- Hikari Connection Pool Tuning ---
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=600000
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# --- Logging Levels ---
LOGGING_LEVEL_COM_SMS=INFO
LOGGING_LEVEL_ORG_FLYWAYDB=INFO
