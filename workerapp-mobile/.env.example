# ==============================================================================
# STORE MANAGEMENT SYSTEM (SMS) — WORKER MOBILE APP ENVIRONMENT TEMPLATE
# Module: Infrastructure Setup (Backlog [A.5])
# ==============================================================================
# Copy this file to workerapp-mobile/.env or configure via flutter --dart-define:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8080

# Backend API Endpoint
# - Android Emulator: http://10.0.2.2:8080
# - iOS Simulator:    http://localhost:8080
# - Physical Device:  http://<YOUR_LAN_IP>:8080 (e.g., http://192.168.1.100:8080)
API_BASE_URL=http://10.0.2.2:8080
WS_BASE_URL=ws://10.0.2.2:8080/ws

# Supabase Mobile Client
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<anon-key>

# GPS Tracking Parameters (Worker App)
GPS_TRACKING_INTERVAL_SECONDS=10
GPS_DISTANCE_FILTER_METERS=15
GPS_MAX_OFFLINE_BUFFER_POINTS=5000
