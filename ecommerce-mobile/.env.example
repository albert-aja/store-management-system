# ==============================================================================
# STORE MANAGEMENT SYSTEM (SMS) — CUSTOMER E-COMMERCE MOBILE ENVIRONMENT TEMPLATE
# Module: Infrastructure Setup (Backlog [A.5])
# ==============================================================================
# Copy this file to ecommerce-mobile/.env or configure via flutter --dart-define:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8080/api/v1/storefront

# Storefront API Endpoint
# - Android Emulator: http://10.0.2.2:8080/api/v1/storefront
# - iOS Simulator:    http://localhost:8080/api/v1/storefront
# - Physical Device:  http://<YOUR_LAN_IP>:8080/api/v1/storefront
API_BASE_URL=http://10.0.2.2:8080/api/v1/storefront

# Supabase Auth Client
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<anon-key>

# Push Notifications (Firebase Cloud Messaging / APNs)
FCM_SENDER_ID=your-fcm-project-id
