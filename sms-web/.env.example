# ==============================================================================
# STORE MANAGEMENT SYSTEM (SMS) — MANAGEMENT WEB SPA ENVIRONMENT TEMPLATE
# Module: Infrastructure Setup (Backlog [A.5])
# ==============================================================================
# Copy this file to sms-web/.env or sms-web/.env.local:

# Authoritative Backend REST API base URL
VITE_API_BASE_URL=http://localhost:8080

# Live Fleet GPS WebSocket STOMP endpoint
VITE_WS_BASE_URL=ws://localhost:8080/ws

# Supabase Authentication & Storage
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<anon-key>

# Application Branding & Features
VITE_APP_TITLE=Store Management System
VITE_DEFAULT_LANGUAGE=id
