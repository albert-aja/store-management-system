# ==============================================================================
# STORE MANAGEMENT SYSTEM (SMS) — ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Module: Infrastructure Setup (Backlog [A.5])
# ==============================================================================
# Instructions: Copy this file to .env before starting services with docker compose:
#   cp .env.example .env

# --- PostgreSQL 16 + PostGIS ---
POSTGRES_DB=sms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_PORT=5432

# --- Redis 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_auth_token_change_me_2026

# --- Authoritative Backend Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Supabase Project Infrastructure ---
# Obtain from your Supabase Dashboard: Project Settings -> API & Database
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_JWKS_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...<your-service-role-secret-key>
SUPABASE_STORAGE_BUCKET=sms-documents

# Live Supabase Postgres Connection (Transaction Pooler: 6543 / Session Pooler: 5432)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USER=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=your_supabase_db_master_password

# --- Web Frontend Endpoints ---
MANAGEMENT_API_URL=http://localhost:8080
MANAGEMENT_WS_URL=ws://localhost:8080/ws
ECOMMERCE_API_URL=http://localhost:8080/api/v1/storefront

# --- Mobile Applications ---
# Android Emulator uses 10.0.2.2, iOS Simulator uses localhost, Physical Device uses LAN IP
MOBILE_API_BASE_URL=http://10.0.2.2:8080
MOBILE_WS_BASE_URL=ws://10.0.2.2:8080/ws
